# @BotFather dan olingan token
BOT_TOKEN=123456789:AA...
# Bot egasining Telegram ID si (/login shu odamga ruxsat, bron xabarlari shunga keladi)
OWNER_ID=
# Botdan foydalanishga ruxsat berilgan boshqa ID lar (vergul bilan)
ALLOWED_IDS=
# Kuzatuvda so'rovlar orasidagi vaqt, sekund (barcha kuzatuvlar uchun umumiy)
POLL_INTERVAL=1
# Ilova (Mini App) uchun mahalliy port
WEBAPP_PORT=8080
# Doimiy HTTPS manzil (server/domen bo'lsa). Bo'sh bo'lsa — cloudflared tunneli avtomatik ochiladi
WEBAPP_URL=
